from typing import Any
import pymysql
from config_manager import get_config


class DatabaseManager:
    """
    Manages database connections with auto-reconnect support.
    """
    
    _instance = None
    _connections: dict = {}
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance
    
    def _create_connection(self, environment: str):
        """Create a new database connection."""
        config = get_config()
        db_config = config.get_section(f"database.{environment}")
        
        if not db_config:
            raise ValueError(f"No database config found for: {environment}")
        
        connection = pymysql.connect(
            host=db_config["host"],
            port=db_config["port"],
            user=db_config["username"],
            password=db_config["password"],
            database=db_config.get("database", ""),
            autocommit=True,
            connect_timeout=10,
            read_timeout=30,
            write_timeout=30
        )
        
        return connection
    
    def _is_connection_alive(self, connection) -> bool:
        """Check if connection is still active."""
        try:
            connection.ping(reconnect=False)
            return True
        except Exception:
            return False
    
    def get_connection(self, environment: str, force_new: bool = False):
        """
        Get a database connection with auto-reconnect.
        
        Args:
            environment: Environment name (qa, uat1, uat2)
            force_new: Force create new connection
            
        Returns:
            Active database connection
        """
        # Force new connection if requested
        if force_new and environment in self._connections:
            self.close_connection(environment)
        
        # Check existing connection
        if environment in self._connections:
            conn = self._connections[environment]
            
            if self._is_connection_alive(conn):
                return conn
            else:
                # Connection dead, remove it
                print(f"Connection to {environment} dropped, reconnecting...")
                del self._connections[environment]
        
        # Create new connection
        connection = self._create_connection(environment)
        self._connections[environment] = connection
        
        return connection
    
    def execute_query(self, environment: str, query: str, params: tuple = None) -> Any:
        """
        Execute query with auto-reconnect on failure.
        """
        max_retries = 2
        
        for attempt in range(max_retries):
            try:
                connection = self.get_connection(environment)
                
                with connection.cursor() as cursor:
                    cursor.execute(query, params)
                    return cursor.fetchall()
                    
            except (pymysql.OperationalError, pymysql.InterfaceError) as e:
                print(f"Query failed (attempt {attempt + 1}): {e}")
                
                # Force reconnect on next attempt
                if environment in self._connections:
                    del self._connections[environment]
                
                if attempt == max_retries - 1:
                    raise
    
    def get_all_connections(self) -> dict:
        """Get connections for all configured environments."""
        config = get_config()
        db_section = config.get_section("database")
        
        for environment in db_section.keys():
            self.get_connection(environment)
        
        return self._connections
    
    def close_connection(self, environment: str) -> None:
        """Close a specific connection."""
        if environment in self._connections:
            try:
                self._connections[environment].close()
            except Exception:
                pass
            del self._connections[environment]
    
    def close_all_connections(self) -> None:
        """Close all connections."""
        for env in list(self._connections.keys()):
            self.close_connection(env)
    
    def reset(self) -> None:
        """Reset manager."""
        self.close_all_connections()


def get_db_manager() -> DatabaseManager:
    """Get DatabaseManager singleton."""
    return DatabaseManager()



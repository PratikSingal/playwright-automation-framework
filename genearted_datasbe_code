import pytest


class TestWithAutoReconnect:
    """
    Tests using session-scoped fixture with auto-reconnect.
    RECOMMENDED approach.
    """
    
    def test_query_one(self, qa_db):
        """Connection auto-reconnects if dropped."""
        conn = qa_db()  # Call the lambda to get connection
        assert conn.open is True
    
    def test_query_two(self, qa_db):
        """Same connection reused, or reconnected if dropped."""
        conn = qa_db()
        
        with conn.cursor() as cursor:
            cursor.execute("SELECT 1")
            result = cursor.fetchone()
        
        assert result is not None


class TestWithFreshConnection:
    """
    Tests that need guaranteed fresh connection.
    Use when test modifies connection state.
    """
    
    def test_fresh_one(self, qa_db_fresh):
        """Gets brand new connection."""
        assert qa_db_fresh.open is True
    
    def test_fresh_two(self, qa_db_fresh):
        """Another brand new connection."""
        assert qa_db_fresh.open is True


class TestWithClassScope:
    """
    Tests sharing connection within class.
    Fresh connection at class start.
    """
    
    def test_class_one(self, qa_db_class):
        """Uses class-level connection."""
        assert qa_db_class.open is True
    
    def test_class_two(self, qa_db_class):
        """Same connection as test_class_one."""
        assert qa_db_class.open is True


class TestUsingDbManager:
    """
    Tests using db_manager directly.
    Most flexible approach.
    """
    
    def test_execute_with_retry(self, db_manager):
        """execute_query has built-in retry."""
        result = db_manager.execute_query("qa", "SELECT 1")
        assert result is not None
    
    def test_multiple_environments(self, db_manager):
        """Access multiple DBs."""
        qa_result = db_manager.execute_query("qa", "SELECT 'qa'")
        uat_result = db_manager.execute_query("uat1", "SELECT 'uat1'")
        
        assert qa_result is not None
        assert uat_result is not None

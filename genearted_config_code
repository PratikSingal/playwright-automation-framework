"""
Example showing how to use ConfigManager in your application.
"""

from config_manager import get_config


def main():
    # Load config once at application startup
    config = get_config().load("config.yaml", env_prefix="APP")
    
    # Access values anywhere
    print("=== Database Configs ===")
    for env in ["qa", "uat1", "uat2"]:
        db = config.get_section(f"database.{env}")
        print(f"{env}: {db['host']}:{db['port']}")
    
    print("\n=== API Config ===")
    print(f"Base URL: {config.get('api.base_url')}")
    print(f"Timeout: {config.get('api.timeout')}")
    
    print("\n=== Full Config ===")
    print(config.data)



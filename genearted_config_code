import os
from typing import Any

import yaml


class ConfigManager:
    """
    Singleton config manager that reads from YAML with environment variable overrides.
    
    On load, all environment variable overrides are applied to the config.
    For nested keys, use double underscores in env vars: DATABASE__QA__HOST -> database.qa.host
    """
    
    _instance = None
    _config: dict = {}
    _env_prefix: str = ""
    _loaded: bool = False
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance
    
    def load(self, config_path: str, env_prefix: str = "") -> "ConfigManager":
        """
        Load configuration from a YAML file and apply all env overrides.
        
        Args:
            config_path: Path to the config file (.yaml, .yml, or .json)
            env_prefix: Optional prefix for environment variables
        """
        if self._loaded:
            return self
        
        self._env_prefix = env_prefix
        
        with open(config_path, 'r') as f:
            self._config = yaml.safe_load(f) or {}
        
        self._apply_all_env_overrides()
        self._loaded = True
        
        return self
    
    def _apply_all_env_overrides(self) -> None:
        """Scan all env vars and apply matching overrides to config."""
        prefix = f"{self._env_prefix}_" if self._env_prefix else ""
        
        for env_key, env_value in os.environ.items():
            if prefix and not env_key.startswith(prefix):
                continue
            
            key = env_key[len(prefix):] if prefix else env_key
            key = key.lower().replace("__", ".")
            
            if self._key_exists(key):
                self._set_nested_value(key, yaml.safe_load(env_value))
    
    def _key_exists(self, key: str) -> bool:
        """Check if a dot-notation key exists in config."""
        keys = key.split(".")
        value = self._config
        
        for k in keys:
            if isinstance(value, dict) and k in value:
                value = value[k]
            else:
                return False
        return True
    
    def _set_nested_value(self, key: str, value: Any) -> None:
        """Set a value in nested dict using dot notation."""
        keys = key.split(".")
        config = self._config
        
        for k in keys[:-1]:
            config = config[k]
        
        config[keys[-1]] = value
    
    def get(self, key: str, default: Any = None) -> Any:
        """
        Get a config value by dot-notation key.
        
        Args:
            key: Dot-notation key (e.g., "database.qa.host")
            default: Default value if key not found
        """
        keys = key.split(".")
        value = self._config
        
        for k in keys:
            if isinstance(value, dict) and k in value:
                value = value[k]
            else:
                return default
        
        return value
    
    def get_section(self, key: str) -> dict:
        """
        Get an entire section as a dictionary.
        
        Example:
            config.get_section("database.qa")
        """
        return self.get(key, {})
    
    @property
    def data(self) -> dict:
        """Return the entire merged config dict."""
        return self._config
    
    @property
    def is_loaded(self) -> bool:
        """Check if config has been loaded."""
        return self._loaded
    
    def __getitem__(self, key: str) -> Any:
        value = self.get(key)
        if value is None:
            raise KeyError(key)
        return value
    
    def reset(self) -> None:
        """Reset the singleton (useful for testing)."""
        self._config = {}
        self._env_prefix = ""
        self._loaded = False


def get_config() -> ConfigManager:
    """Get the ConfigManager singleton instance."""
    return ConfigManager()



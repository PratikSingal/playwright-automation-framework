import os
import pytest


class TestConfigManager:
    """Tests for ConfigManager."""
    
    def test_config_loaded(self, config):
        """Test that config is loaded."""
        assert config.is_loaded is True
    
    def test_get_nested_value(self, config):
        """Test getting nested values."""
        host = config.get("database.qa.host")
        assert host == "qa-db.example.com"
    
    def test_get_section(self, config):
        """Test getting entire section."""
        qa_config = config.get_section("database.qa")
        
        assert "host" in qa_config
        assert "username" in qa_config
        assert "password" in qa_config
    
    def test_get_with_default(self, config):
        """Test default value for missing key."""
        value = config.get("nonexistent.key", "default_value")
        assert value == "default_value"
    
    def test_data_property(self, config):
        """Test accessing entire config."""
        data = config.data
        
        assert "database" in data
        assert "api" in data
    
    def test_dict_access(self, config):
        """Test dict-style access."""
        host = config["database.qa.host"]
        assert host == "qa-db.example.com"
    
    def test_dict_access_missing_key(self, config):
        """Test KeyError for missing key."""
        with pytest.raises(KeyError):
            _ = config["nonexistent.key"]


class TestDatabaseConfig:
    """Tests using db_config fixture."""
    
    def test_qa_config(self, db_config):
        """Test QA database config."""
        qa = db_config["qa"]
        
        assert qa["host"] == "qa-db.example.com"
        assert qa["port"] == 5432
    
    def test_uat1_config(self, db_config):

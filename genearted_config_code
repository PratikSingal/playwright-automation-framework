import os
import pytest
from config_manager import ConfigManager


@pytest.fixture
def fresh_config():
    """
    Function-scoped fixture with fresh config for env override tests.
    """
    config = ConfigManager()
    config.reset()
    yield config
    config.reset()


class TestEnvOverride:
    """Test environment variable overrides."""
    
    def test_env_override_single_value(self, fresh_config, tmp_path):
        """Test single value override."""
        # Create temp config file
        config_file = tmp_path / "config.yaml"
        config_file.write_text("""
database:
  qa:
    host: "original-host"
""")
        
        # Set env var
        os.environ["TEST_DATABASE__QA__HOST"] = "overridden-host"
        
        try:
            fresh_config.load(str(config_file), env_prefix="TEST")
            assert fresh_config.get("database.qa.host") == "overridden-host"
        finally:
            del os.environ["TEST_DATABASE__QA__HOST"]
    
    def test_env_override_multiple_values(self, fresh_config, tmp_path):
        """Test multiple value overrides."""
        config_file = tmp_path / "config.yaml"
        config_file.write_text("""
database:
  qa:
    host: "original-host"
    port: 5432
    username: "original-user"
""")
        
        os.environ["TEST_DATABASE__QA__HOST"] = "new-host"
        os.environ["TEST_DATABASE__QA__PORT"] = "3306"
        os.environ["TEST_DATABASE__QA__USERNAME"] = "new-user"
        
        try:
            fresh_config.load(str(config_file), env_prefix="TEST")
            
            assert fresh_config.get("database.qa.host") == "new-host"
            assert fresh_config.get("database.qa.port") == 3306  # Note: int
            assert fresh_config.get("database.qa.username") == "new-user"
        finally:
            del os.environ["TEST_DATABASE__QA__HOST"]
            del os.environ["TEST_DATABASE__QA__PORT"]
            del os.environ["TEST_DATABASE__QA__USERNAME"]
    
    def test_env_override_preserves_non_overridden(self, fresh_config, tmp_path):
        """Test that non-overridden values are preserved."""
        config_file = tmp_path / "config.yaml"
        config_file.write_text("""
database:
  qa:
    host: "original-host"
    password: "secret"
""")
        
        os.environ["TEST_DATABASE__QA__HOST"] = "new-host"
        
        try:
            fresh_config.load(str(config_file), env_prefix="TEST")
            
            assert fresh_config.get("database.qa.host") == "new-host"
            assert fresh_config.get("database.qa.password") == "secret"
        finally:
            del os.environ["TEST_DATABASE__QA__HOST"]



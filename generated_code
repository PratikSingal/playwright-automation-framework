@allure.step("Fill textbox by role: {name}")
def fill_textbox_by_role(
    self, 
    name: str, 
    value: str, 
    exact: bool = False,
    iframe_locator: str = None
) -> None:
    """
    Fill textbox using accessibility role with optional iframe support
    
    Args:
        name: Accessible name of the textbox (from aria-label, label, or placeholder)
        value: Value to fill
        exact: Exact match for the name
        iframe_locator: Optional iframe CSS selector (e.g., '#iframeView')
    
    Examples:
        # Without iframe
        actions.fill_textbox_by_role("Account Name", "Test Account")
        
        # With iframe
        actions.fill_textbox_by_role("Account Name", "Test Account", iframe_locator="#iframeView")
    """
    try:
        logger.info(f"Filling textbox '{name}' with value '{value}'" + 
                   (f" in iframe '{iframe_locator}'" if iframe_locator else ""))
        
        if iframe_locator:
            # Work inside iframe
            frame = self.page.frame_locator(iframe_locator)
            frame.get_by_role("textbox", name=name, exact=exact).fill(value)
        else:
            # Work on main page
            self.page.get_by_role("textbox", name=name, exact=exact).fill(value)
        
        logger.success(f"Successfully filled textbox '{name}'")
        
    except Exception as e:
        logger.error(f"Failed to fill textbox '{name}': {str(e)}")
        raise





def verify_form_data(
    self, 
    field_mapping: Dict[str, Any], 
    expected_data: Dict[str, Any],
    iframe_locator: Optional[str] = None,
    timeout: int = 5000
) -> None:
    """
    Generic method to verify form data based on field type and method
    Supports: get_by_label, get_by_placeholder, get_by_role, get_by_text, cell-based, and direct locators
    
    Args:
        field_mapping: Dictionary mapping field names to their configuration
            Example: {
                'account_name': {
                    'cell_name': 'Account Name',
                    'type': 'textbox',
                    'method': 'cell',
                    'iframe_locator': '#iframeView'
                },
                'username': {
                    'locator': 'Username',
                    'type': 'textbox',
                    'method': 'get_by_label',
                    'exact': False
                }
            }
        expected_data: Dictionary containing expected values to verify
            Example: {
                'account_name': 'TEST_AT_PR1',
                'username': 'john_doe'
            }
        iframe_locator: Optional iframe locator for fields inside iframe (can be overridden per field)
        timeout: Timeout for assertions in milliseconds (default: 5000)
    """
    logger.info("Starting to verify form data")
    
    for field_name, expected_value in expected_data.items():
        if field_name not in field_mapping:
            logger.warning(f"Field '{field_name}' not found in mapping, skipping verification")
            continue
        
        field_config = field_mapping[field_name]
        field_type = field_config['type'].lower()
        method = field_config.get('method', 'locator')
        
        # Use iframe_locator from field config if present, otherwise use the parameter
        field_iframe = field_config.get('iframe_locator', iframe_locator)
        
        try:
            with allure.step(f"Verifying field: {field_name} = {expected_value}"):
                
                # ==========================================
                # HANDLE CELL-BASED VERIFICATION
                # ==========================================
                if method == 'cell':
                    cell_name = field_config.get('cell_name')
                    if not cell_name:
                        raise ValueError(f"Field '{field_name}' uses 'cell' method but missing 'cell_name'")
                    
                    logger.info(f"Verifying cell-based field: '{field_name}' (cell: '{cell_name}')")
                    
                    # Use iframe-aware cell verification
                    self.actions.verify_by_cell(
                        cell_name=cell_name,
                        field_type=field_type,
                        expected_value=expected_value,
                        iframe_locator=field_iframe,
                        timeout=timeout
                    )
                
                # ==========================================
                # HANDLE GET_BY_LABEL VERIFICATION
                # ==========================================
                elif method == 'get_by_label':
                    locator = field_config['locator']
                    exact = field_config.get('exact', False)
                    
                    # Handle dynamic locators (e.g., radio buttons with {value})
                    if '{' in locator and isinstance(expected_value, str):
                        locator = locator.format(value=expected_value)
                    
                    logger.info(f"Verifying by label: '{field_name}' (label: '{locator}')")
                    
                    # Get element using label
                    element = self._get_element_by_method(
                        method='get_by_label',
                        field_type=field_type,
                        locator=locator,
                        exact=exact,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify value
                    self._verify_field_value(element, field_type, expected_value, timeout)
                
                # ==========================================
                # HANDLE GET_BY_PLACEHOLDER VERIFICATION
                # ==========================================
                elif method == 'get_by_placeholder':
                    locator = field_config['locator']
                    
                    logger.info(f"Verifying by placeholder: '{field_name}' (placeholder: '{locator}')")
                    
                    # Get element using placeholder
                    element = self._get_element_by_method(
                        method='get_by_placeholder',
                        field_type=field_type,
                        locator=locator,
                        exact=False,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify value
                    self._verify_field_value(element, field_type, expected_value, timeout)
                
                # ==========================================
                # HANDLE GET_BY_ROLE VERIFICATION
                # ==========================================
                elif method == 'get_by_role':
                    locator = field_config['locator']
                    exact = field_config.get('exact', False)
                    
                    logger.info(f"Verifying by role: '{field_name}' (role: '{field_type}', name: '{locator}')")
                    
                    # Get element using role
                    element = self._get_element_by_method(
                        method='get_by_role',
                        field_type=field_type,
                        locator=locator,
                        exact=exact,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify value
                    self._verify_field_value(element, field_type, expected_value, timeout)
                
                # ==========================================
                # HANDLE GET_BY_TEXT VERIFICATION
                # ==========================================
                elif method == 'get_by_text':
                    locator = field_config['locator']
                    exact = field_config.get('exact', False)
                    
                    logger.info(f"Verifying by text: '{field_name}' (text: '{locator}')")
                    
                    # Get element using text
                    element = self._get_element_by_method(
                        method='get_by_text',
                        field_type=field_type,
                        locator=locator,
                        exact=exact,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify visibility/enabled state
                    if field_type in ['link', 'button']:
                        if bool(expected_value):
                            expect(element).to_be_visible(timeout=timeout)
                    else:
                        self._verify_field_value(element, field_type, expected_value, timeout)
                
                # ==========================================
                # HANDLE DIRECT LOCATOR VERIFICATION (CSS/XPATH)
                # ==========================================
                else:  # method == 'locator' or any other
                    locator = field_config.get('locator')
                    
                    if not locator:
                        raise ValueError(f"Field '{field_name}' missing 'locator' in config")
                    
                    # Handle dynamic locators
                    if '{' in locator and isinstance(expected_value, str):
                        locator = locator.format(value=expected_value)
                    
                    logger.info(f"Verifying by locator: '{field_name}' (locator: '{locator}')")
                    
                    # Get element using direct locator
                    element = self._get_element_by_method(
                        method='locator',
                        field_type=field_type,
                        locator=locator,
                        exact=False,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify value
                    self._verify_field_value(element, field_type, expected_value, timeout)
                
                logger.success(f"✓ Field '{field_name}' verified successfully")
                
        except AssertionError as e:
            logger.error(f"✗ Verification failed for field '{field_name}': {str(e)}")
            
            # Attach error details to Allure report
            allure.attach(
                f"Field: {field_name}\n"
                f"Expected: {expected_value}\n"
                f"Method: {method}\n"
                f"Error: {str(e)}",
                name=f"Verification Failed: {field_name}",
                attachment_type=allure.attachment_type.TEXT
            )
            
            # Take screenshot for debugging
            try:
                screenshot_bytes = self.page.screenshot(full_page=True)
                allure.attach(
                    screenshot_bytes,
                    name=f"Error Screenshot: {field_name}",
                    attachment_type=allure.attachment_type.PNG
                )
            except Exception as screenshot_error:
                logger.warning(f"Failed to capture screenshot: {screenshot_error}")
            
            raise
        
        except Exception as e:
            logger.error(f"✗ Unexpected error verifying field '{field_name}': {str(e)}")
            
            allure.attach(
                str(e),
                name=f"Unexpected Error: {field_name}",
                attachment_type=allure.attachment_type.TEXT
            )
            raise
    
    logger.success("✅ All form data verified successfully")





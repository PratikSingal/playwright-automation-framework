@pytest.fixture(scope="function")
def context(browser: Browser, config_manager, request) -> BrowserContext:
    """
    Create a new browser context for each test
    Browser context is like an incognito window - isolated cookies, cache, etc.
    """
    viewport = config_manager.get('browser.viewport', {'width': 1920, 'height': 1080})
    
    logger.info("Creating new browser context")
    
    # Context options
    context_options = {
        'viewport': viewport,
        'ignore_https_errors': True,
        'java_script_enabled': True,
        'accept_downloads': True
    }
    
    # Always enable video recording to capture it
    video_dir = Path(config_manager.get('reporting.videos', 'reports/videos'))
    video_dir.mkdir(parents=True, exist_ok=True)
    context_options['record_video_dir'] = str(video_dir)
    context_options['record_video_size'] = viewport
    
    context = browser.new_context(**context_options)
    
    # Enable tracing for debugging
    if config_manager.get('browser.trace_on_failure', True):
        context.tracing.start(screenshots=True, snapshots=True, sources=True)
    
    logger.success("Browser context created")
    
    yield context
    
    # Check if test failed
    test_failed = False
    if hasattr(request.node, 'rep_call'):
        test_failed = request.node.rep_call.failed
    
    # Stop tracing before closing pages
    if config_manager.get('browser.trace_on_failure', True):
        try:
            context.tracing.stop()
        except Exception as e:
            logger.warning(f"Failed to stop tracing: {str(e)}")
    
    # Handle video based on test result
    if test_failed:
        logger.warning("Test failed - keeping and attaching video")
        
        # Attach video to Allure report
        try:
            for page in context.pages:
                if page.video:
                    # Close page to finalize video
                    page.close()
                    
                    # Get video path after closing
                    video_path = page.video.path()
                    
                    if video_path:
                        video_file = Path(video_path)
                        
                        # Wait briefly for video file to be written
                        import time
                        max_wait = 5  # seconds
                        wait_interval = 0.2
                        elapsed = 0
                        
                        while not video_file.exists() and elapsed < max_wait:
                            time.sleep(wait_interval)
                            elapsed += wait_interval
                        
                        if video_file.exists():
                            # Attach to Allure report
                            allure.attach.file(
                                str(video_file),
                                name=f"Test Video - {request.node.name}",
                                attachment_type=allure.attachment_type.WEBM,
                                extension=".webm"
                            )
                            logger.info(f"Video attached to Allure: {video_path}")
                        else:
                            logger.warning(f"Video file not found: {video_path}")
                else:
                    page.close()
        except Exception as e:
            logger.error(f"Failed to attach video: {str(e)}")
            # Close any remaining pages
            for page in context.pages:
                try:
                    page.close()
                except:
                    pass
    else:
        logger.info("Test passed - deleting video")
        
        # Collect video paths before closing pages
        video_paths = []
        try:
            for page in context.pages:
                if page.video:
                    video_path = page.video.path()
                    if video_path:
                        video_paths.append(Path(video_path))
                page.close()
        except Exception as e:
            logger.debug(f"Error while collecting video paths: {str(e)}")
        
        # Close context to finalize all videos
        logger.info("Closing browser context")
        context.close()
        
        # Now delete the video files
        for video_file in video_paths:
            try:
                if video_file.exists():
                    video_file.unlink()
                    logger.debug(f"Deleted video: {video_file}")
            except Exception as e:
                logger.debug(f"Could not delete video {video_file}: {str(e)}")
        
        # Also clean up any orphaned videos in the directory
        try:
            video_dir = Path(config_manager.get('reporting.videos', 'reports/videos'))
            for orphaned_video in video_dir.glob('*.webm'):
                # Only delete if it's from a recent run (within last hour)
                if time.time() - orphaned_video.stat().st_mtime < 3600:
                    try:
                        orphaned_video.unlink()
                        logger.debug(f"Deleted orphaned video: {orphaned_video}")
                    except:
                        pass
        except Exception as e:
            logger.debug(f"Error cleaning up orphaned videos: {str(e)}")
        
        return  # Early return since context is already closed
    
    # If test failed, close context normally
    logger.info("Closing browser context")
    context.close()

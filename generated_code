def verify_form_data(
    self, 
    field_mapping: Dict[str, Any], 
    expected_data: Dict[str, Any],
    iframe_locator: Optional[str] = None,
    timeout: int = 5000
) -> None:
    """
    Generic method to verify form data based on field type and method
    Uses iframe-aware generic methods from GenericActions
    
    Args:
        field_mapping: Dictionary mapping field names to their configuration
        expected_data: Dictionary containing expected values to verify
        iframe_locator: Optional iframe locator for fields inside iframe
        timeout: Timeout for assertions in milliseconds
    """
    logger.info("Starting to verify form data")
    
    for field_name, expected_value in expected_data.items():
        if field_name not in field_mapping:
            logger.warning(f"Field '{field_name}' not found in mapping, skipping verification")
            continue
        
        field_config = field_mapping[field_name]
        field_type = field_config['type'].lower()
        method = field_config.get('method', 'locator')
        
        # Use iframe_locator from field config if present, otherwise use the parameter
        field_iframe = field_config.get('iframe_locator', iframe_locator)
        
        try:
            with allure.step(f"Verifying field: {field_name} = {expected_value}"):
                
                # Get locator and exact match setting
                locator = field_config.get('locator')
                exact = field_config.get('exact', False)
                
                # Handle dynamic locators
                if locator and '{' in locator and isinstance(expected_value, str):
                    locator = locator.format(value=expected_value)
                
                # ==========================================
                # ROUTE TO APPROPRIATE GENERIC METHOD
                # ==========================================
                
                if method == 'get_by_label':
                    self._verify_by_label(field_type, locator, expected_value, exact, field_iframe, timeout)
                
                elif method == 'get_by_role':
                    self._verify_by_role(field_type, locator, expected_value, exact, field_iframe, timeout)
                
                elif method == 'get_by_placeholder':
                    self._verify_by_placeholder(field_type, locator, expected_value, field_iframe, timeout)
                
                elif method == 'locator':
                    self._verify_by_locator(field_type, locator, expected_value, field_iframe, timeout)
                
                else:
                    raise ValueError(f"Unknown method '{method}' for field '{field_name}'")
                
                logger.success(f"✓ Field '{field_name}' verified successfully")
                
        except AssertionError as e:
            logger.error(f"✗ Verification failed for field '{field_name}': {str(e)}")
            raise
        
        except Exception as e:
            logger.error(f"✗ Unexpected error verifying field '{field_name}': {str(e)}")
            raise
    
    logger.success("✅ All form data verified successfully")


def _verify_by_label(self, field_type: str, locator: str, expected_value: Any, exact: bool, iframe_locator: Optional[str], timeout: int):
    """Verify field using get_by_label - delegates to iframe-aware generic methods"""
    
    if field_type in ['textbox', 'textarea']:
        self.actions.verify_textbox_by_label(
            label=locator,
            expected_value=str(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    elif field_type == 'checkbox':
        self.actions.verify_checkbox_by_label(
            label=locator,
            should_be_checked=bool(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    elif field_type == 'radio':
        self.actions.verify_radio_by_label(
            label=locator,
            should_be_checked=bool(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    else:
        raise ValueError(f"Unsupported field type '{field_type}' for get_by_label verification")


def _verify_by_role(self, field_type: str, locator: str, expected_value: Any, exact: bool, iframe_locator: Optional[str], timeout: int):
    """Verify field using get_by_role - delegates to iframe-aware generic methods"""
    
    if field_type == 'textbox':
        self.actions.verify_textbox_by_role(
            name=locator,
            expected_value=str(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    elif field_type == 'checkbox':
        self.actions.verify_checkbox_by_role(
            name=locator,
            should_be_checked=bool(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    elif field_type == 'button':
        self.actions.verify_button_by_role(
            name=locator,
            should_be_visible=bool(expected_value),
            iframe_locator=iframe_locator,
            exact=exact,
            timeout=timeout
        )
    
    else:
        raise ValueError(f"Unsupported field type '{field_type}' for get_by_role verification")



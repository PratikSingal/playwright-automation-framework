def verify_form_data(
    self, 
    field_mapping: Dict[str, Any], 
    expected_data: Dict[str, Any],
    iframe_locator: Optional[str] = None,
    timeout: int = 5000
) -> None:
    """
    Generic method to verify form data based on field type and method
    Supports: get_by_label, get_by_placeholder, get_by_role, get_by_text, cell-based, and direct locators
    
    Args:
        field_mapping: Dictionary mapping field names to their configuration
        expected_data: Dictionary containing expected values to verify
        iframe_locator: Optional iframe locator for fields inside iframe (can be overridden per field)
        timeout: Timeout for assertions in milliseconds (default: 5000)
    """
    logger.info("Starting to verify form data")
    
    for field_name, expected_value in expected_data.items():
        if field_name not in field_mapping:
            logger.warning(f"Field '{field_name}' not found in mapping, skipping verification")
            continue
        
        field_config = field_mapping[field_name]
        field_type = field_config['type'].lower()
        method = field_config.get('method', 'locator')
        
        # Use iframe_locator from field config if present, otherwise use the parameter
        field_iframe = field_config.get('iframe_locator', iframe_locator)
        
        try:
            with allure.step(f"Verifying field: {field_name} = {expected_value}"):
                
                # ==========================================
                # HANDLE CELL-BASED VERIFICATION
                # ==========================================
                if method == 'cell':
                    cell_name = field_config.get('cell_name')
                    if not cell_name:
                        raise ValueError(f"Field '{field_name}' uses 'cell' method but missing 'cell_name'")
                    
                    logger.info(f"Verifying cell-based field: '{field_name}' (cell: '{cell_name}')")
                    
                    # Call GenericActions method which has @iframe_aware decorator
                    self.actions.verify_by_cell(
                        cell_name=cell_name,
                        field_type=field_type,
                        expected_value=expected_value,
                        iframe_locator=field_iframe,
                        timeout=timeout
                    )
                
                # ==========================================
                # HANDLE OTHER METHODS
                # ==========================================
                else:
                    # Get locator
                    locator = field_config.get('locator')
                    exact = field_config.get('exact', False)
                    
                    if not locator and method != 'cell':
                        raise ValueError(f"Field '{field_name}' missing 'locator' in config")
                    
                    # Handle dynamic locators
                    if locator and '{' in locator and isinstance(expected_value, str):
                        locator = locator.format(value=expected_value)
                    
                    logger.info(f"Verifying field: '{field_name}' using method: '{method}'")
                    
                    # Get element based on method
                    element = self._get_element_by_method(
                        method=method,
                        field_type=field_type,
                        locator=locator,
                        exact=exact,
                        iframe_locator=field_iframe
                    )
                    
                    # Verify value
                    self._verify_field_value(element, field_type, expected_value, timeout)
                
                logger.success(f"✓ Field '{field_name}' verified successfully")
                
        except AssertionError as e:
            logger.error(f"✗ Verification failed for field '{field_name}': {str(e)}")
            raise
        
        except Exception as e:
            logger.error(f"✗ Unexpected error verifying field '{field_name}': {str(e)}")
            raise
    
    logger.success("✅ All form data verified successfully")


def _get_element_by_method(
    self, 
    method: str, 
    field_type: str, 
    locator: str, 
    exact: bool, 
    iframe_locator: Optional[str] = None
):
    """
    Get element based on locator method - manually handles iframe context
    Does NOT use @iframe_aware decorator (that's only in GenericActions)
    """
    
    # Manually get the correct context (page or iframe)
    context = self.page.frame_locator(iframe_locator) if iframe_locator else self.page
    
    if method == 'get_by_label':
        return context.get_by_label(locator, exact=exact)
    
    elif method == 'get_by_placeholder':
        return context.get_by_placeholder(locator)
    
    elif method == 'get_by_role':
        return context.get_by_role(field_type, name=locator, exact=exact)
    
    elif method == 'get_by_text':
        return context.get_by_text(locator, exact=exact)
    
    else:  # method == 'locator' (CSS/XPath)
        return context.locator(locator)


def _verify_field_value(
    self, 
    element, 
    field_type: str, 
    expected_value: Any, 
    timeout: int
):
    """Verify field value based on type"""
    
    if field_type in ['textbox', 'textarea', 'searchbox', 'spinbutton']:
        expect(element).to_have_value(str(expected_value), timeout=timeout)
    
    elif field_type == 'checkbox':
        if bool(expected_value):
            expect(element).to_be_checked(timeout=timeout)
        else:
            expect(element).not_to_be_checked(timeout=timeout)
    
    elif field_type == 'radio':
        expect(element).to_be_checked(timeout=timeout)
    
    elif field_type in ['dropdown', 'combobox', 'select']:
        expect(element).to_have_value(str(expected_value), timeout=timeout)
    
    elif field_type in ['link', 'button']:
        if bool(expected_value):
            expect(element).to_be_visible(timeout=timeout)
    
    else:
        logger.warning(f"Unknown field type '{field_type}' for verification, defaulting to value check")
        expect(element).to_have_value(str(expected_value), timeout=timeout)




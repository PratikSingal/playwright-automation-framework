@allure.step("Select dropdown by label: {label}")
def select_dropdown_by_label(
    self, 
    label: str, 
    value: str = None,
    label_text: str = None,
    index: int = None,
    exact: bool = False
) -> None:
    """Select dropdown option using associated label
    
    Args:
        label: The label text associated with the dropdown
        value: Select by option value attribute (optional)
        label_text: Select by option visible text (optional)
        index: Select by option index (optional)
        exact: Whether to use exact match for label
        
    Note: Provide exactly one of: value, label_text, or index
    """
    try:
        logger.info(f"Selecting from dropdown with label '{label}'")
        dropdown = self.page.get_by_label(label, exact=exact)
        dropdown.wait_for(state="visible", timeout=self.timeout)
        
        # Select based on the provided parameter
        if value is not None:
            dropdown.select_option(value=value)
            logger.success(f"Successfully selected option with value '{value}'")
        elif label_text is not None:
            dropdown.select_option(label=label_text)
            logger.success(f"Successfully selected option with label '{label_text}'")
        elif index is not None:
            dropdown.select_option(index=index)
            logger.success(f"Successfully selected option at index {index}")
        else:
            raise ValueError("Must provide one of: value, label_text, or index")
            
    except Exception as e:
        logger.error(f"Failed to select dropdown with label '{label}': {str(e)}")
        raise



def _fill_by_label(self, field_type: str, locator: str, value: Any, exact: bool, field_config: Dict = None) -> None:
    """Fill field using get_by_label"""
    if field_type in ['textbox', 'textarea']:
        self.actions.fill_by_label(locator, str(value), exact=exact)
    elif field_type == 'checkbox':
        if bool(value):
            self.actions.check_by_label(locator, exact=exact)
        else:
            self.actions.uncheck_by_label(locator, exact=exact)
    elif field_type == 'radio':
        self.actions.check_by_label(locator, exact=exact)
    elif field_type == 'dropdown':
        # Handle dropdown with value/label/index flexibility
        select_by = field_config.get('select_by', 'value') if field_config else 'value'
        
        if select_by == 'value':
            self.actions.select_dropdown_by_label(locator, value=str(value), exact=exact)
        elif select_by == 'label':
            self.actions.select_dropdown_by_label(locator, label_text=str(value), exact=exact)
        elif select_by == 'index':
            self.actions.select_dropdown_by_label(locator, index=int(value), exact=exact)
        else:
            raise ValueError(f"Invalid select_by option: {select_by}. Use 'value', 'label', or 'index'")

@iframe_aware
@allure.step("Verify dropdown by label: {label} = {expected_value}")
def verify_dropdown_by_label(
    self,
    label: str,
    expected_value: str = None,
    expected_label: str = None,
    expected_index: int = None,
    iframe_locator: Optional[str] = None,
    exact: bool = False,
    timeout: int = 5000,
    index: int = 0
) -> None:
    """Verify dropdown value using label
    
    Args:
        label: Label text associated with the dropdown
        expected_value: Expected option value attribute (optional)
        expected_label: Expected option visible text (optional)
        expected_index: Expected selected index (optional)
        iframe_locator: Optional iframe locator
        exact: Exact match for label
        timeout: Timeout for assertion
        index: Index if multiple dropdowns with same label
        
    Note: Provide exactly one of: expected_value, expected_label, or expected_index
    """
    try:
        logger.info(f"Verifying dropdown with label '{label}'")
        
        # Get the dropdown element
        element = self.page.get_by_label(label, exact=exact).nth(index)
        
        # Verify based on what's expected
        if expected_value is not None:
            # Verify by option value attribute
            expect(element).to_have_value(expected_value, timeout=timeout)
            logger.success(f"✓ Dropdown '{label}' has value '{expected_value}'")
            
        elif expected_label is not None:
            # Verify by visible text of selected option
            selected_text = element.evaluate("""
                element => {
                    const selectedOption = element.options[element.selectedIndex];
                    return selectedOption ? selectedOption.text : '';
                }
            """)
            
            if selected_text == expected_label:
                logger.success(f"✓ Dropdown '{label}' shows '{expected_label}'")
            else:
                raise AssertionError(f"Expected label '{expected_label}', but got '{selected_text}'")
                
        elif expected_index is not None:
            # Verify by selected index
            selected_index = element.evaluate("element => element.selectedIndex")
            
            if selected_index == expected_index:
                logger.success(f"✓ Dropdown '{label}' has index {expected_index} selected")
            else:
                raise AssertionError(f"Expected index {expected_index}, but got {selected_index}")
        else:
            raise ValueError("Must provide one of: expected_value, expected_label, or expected_index")
            
    except AssertionError as e:
        logger.error(f"✗ Verification failed: {str(e)}")
        raise

elif field_type == 'dropdown':

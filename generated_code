# ==================== IFRAME-AWARE VERIFICATION METHODS ====================

@iframe_aware
@allure.step("Verify textbox by label: {label} = {expected_value}")
def verify_textbox_by_label(
    self,
    label: str,
    expected_value: str,
    iframe_locator: Optional[str] = None,
    exact: bool = False,
    timeout: int = 5000
) -> None:
    """Verify textbox value using label"""
    try:
        logger.info(f"Verifying textbox with label '{label}' = '{expected_value}'")
        element = self.page.get_by_label(label, exact=exact)
        expect(element).to_have_value(expected_value, timeout=timeout)
        logger.success(f"✓ Textbox '{label}' verified")
    except AssertionError as e:
        logger.error(f"✗ Verification failed: {str(e)}")
        raise



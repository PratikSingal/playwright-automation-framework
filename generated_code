@iframe_aware
@allure.step("Verify checkbox by label: {label}")
def verify_checkbox_by_label(
    self,
    label: str,
    should_be_checked: bool,
    iframe_locator: Optional[str] = None,
    exact: bool = False,
    timeout: int = 5000
) -> None:
    """Verify checkbox state using label"""
    try:
        state = "checked" if should_be_checked else "unchecked"
        logger.info(f"Verifying checkbox '{label}' is {state}")
        element = self.page.get_by_label(label, exact=exact)
        
        if should_be_checked:
            expect(element).to_be_checked(timeout=timeout)
        else:
            expect(element).not_to_be_checked(timeout=timeout)
        
        logger.success(f"✓ Checkbox '{label}' is {state}")
    except AssertionError as e:
        logger.error(f"✗ Verification failed: {str(e)}")
        raise



@iframe_aware
@allure.step("Validate dropdown has {expected_count} items for search context")
def validate_dropdown_item_count(
    self, 
    expected_count: int, 
    parent_class: str = "car-context-quick-search-list",
    iframe_locator: Optional[str] = None
) -> None:
    """
    Validate the number of items in a specific dropdown
    
    Args:
        expected_count: Expected number of dropdown items
        parent_class: The unique parent class to identify the dropdown
        iframe_locator: Optional iframe locator
    """
    try:
        logger.info(f"Validating dropdown has {expected_count} items")
        
        # Target items within the specific parent container
        items = self.page.locator(f".{parent_class} li.ui-menu-item")
        
        # Wait for items to appear if count > 0
        if expected_count > 0:
            items.first.wait_for(state="visible", timeout=5000)
        
        # Count visible items
        actual_count = items.count()
        
        logger.info(f"Found {actual_count} dropdown items in '.{parent_class}'")
        
        # Validate count
        assert actual_count == expected_count, \
            f"Expected {expected_count} dropdown items, but found {actual_count}"
        
        logger.success(f"✓ Dropdown has correct number of items: {expected_count}")
        
    except Exception as e:
        logger.error(f"Failed to validate dropdown count: {str(e)}")
        self.page.screenshot(path="dropdown_validation_error.png")
        raise

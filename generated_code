def _verify_by_locator(self, field_type: str, locator: str, expected_value: Any, iframe_locator: Optional[str], timeout: int):
    """Verify field using direct locator - delegates to iframe-aware generic methods"""
    
    if field_type in ['textbox', 'textarea']:
        self.actions.verify_textbox_by_locator(
            locator=locator,
            expected_value=str(expected_value),
            iframe_locator=iframe_locator,
            timeout=timeout
        )
    
    elif field_type == 'checkbox':
        self.actions.verify_checkbox_by_locator(
            locator=locator,
            should_be_checked=bool(expected_value),
            iframe_locator=iframe_locator,
            timeout=timeout
        )
    
    elif field_type == 'radio':
        self.actions.verify_radio_by_locator(
            locator=locator,
            should_be_checked=bool(expected_value),
            iframe_locator=iframe_locator,
            timeout=timeout
        )
    
    else:
        raise ValueError(f"Unsupported field type '{field_type}' for locator verification")
